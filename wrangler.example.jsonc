{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restaurant-stoplist-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "observability": {
    "enabled": true
  },
  "vars": {
    "BOT_USERNAME": "your_restaurant_bot",
    "OWNER_USER_ID": "REPLACE_WITH_OWNER_TELEGRAM_ID",
    "MANAGER_USER_ID": "REPLACE_WITH_MANAGER_TELEGRAM_ID",
    "PUBLIC_URL": "https://your-worker.workers.dev"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-stoplist-bot-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
